# SPDX-License-Identifier: GPL-2.0-only
# Per-device kernel config fragment for Google Pixel 10 Pro XL (mustang, laguna).
# Merged on top of kernel/configs/omamobile.config by `DEVICE=mustang bin/omamobile kernel`.

# Tensor G5 (laguna / lga) platform support and arch/arm64/boot/dts/google/ DTBs
# (mainline Linux v7.4 commits cf3df78629f2, ecf6405fa6c5).
CONFIG_ARCH_GOOGLE=y

# Disable ACPI so generic arm64 ACPI 8250 enumeration cannot claim ttyS0 ahead
# of DT serial0 = &uart0 (serial@db62000) and break serial console / earlycon.
# CONFIG_ACPI is not set

# Synopsys DesignWare APB UART ("google,lga-uart", "snps,dw-apb-uart" at 0xdb62000).
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y

# USB Type-C and Tensor G5 DWC3 + USB2/USB3.2 Gen 2 PHY drivers
# (mainline Linux v7.4 commits 18686b294c6f and 42d6a93bff56; PHY depends on TYPEC).
CONFIG_TYPEC=y
CONFIG_USB_DWC3_GOOGLE=y
CONFIG_PHY_GOOGLE_USB=y

# Imagination PowerVR DRM driver skeleton. Mainline pvr_drv.c does not yet bind
# laguna's DXT-48-1536 (BVNC 71.2.2448.1212), so M1 renders in software over
# simpledrm + llvmpipe; keep modular for subsequent GPU bring-up.
CONFIG_DRM_IMAGINATION=m
